{
  "id": "type_animator",
  "name": "Type Animator",
  "category": "geometric",
  "role": "generator",
  "requires_input": false,
  "performance_group": "main_visual",
  "genre": ["hardtechno", "techno", "all"],
  "description": "Audio-reactive block typography with preset words and custom text.",
