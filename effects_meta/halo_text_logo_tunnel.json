{
  "schema_version": 2,
  "effect_id": "halo_text_logo_tunnel",
  "name": "Halo Text Logo Tunnel",
  "category": "geometric",
  "role": "generator",
  "performance_group": "main_visual",
  "quality_cost": "medium",
  "requires_input": false,
  "description": "GIF-inspired monochrome tunnel with a central logo, repeated perspective text rings, scanlines, barcode columns, smoke noise, and optional audio-reactive glitch.",
  "author": "VJLink",
  "controls": [
    { "param": "center_logo_slot", "label": "Center Logo Slot", "type": "select", "default": 0, "min": 0, "max": 2, "step": 1, "group": "Texture/Input", "basic": true, "advanced": false, "audio_target": null, "save": true, "options": ["Logo 1", "Logo 2", "Logo 3"] },
    { "param": "main_text", "label": "Main Text", "type": "select", "default": 6, "min": 0, "max": 6, "step": 1, "group": "Main", "basic": true, "advanced": false, "audio_target": null, "save": true, "options": ["HALO WHO?", "VJLINK", "RAVE", "HARDTECHNO", "VOID?", "GATE?", "BOSO"] },
    { "param": "ring_count", "label": "Ring Count", "type": "float", "default": 8, "min": 1, "max": 10, "step": 1, "group": "Main", "basic": true, "advanced": false, "audio_target": "energy", "save": true },
    { "param": "ring_text_active", "label": "Custom Ring Text", "type": "bool", "default": 1, "min": 0, "max": 1, "step": 1, "group": "Main", "basic": true, "advanced": false, "audio_target": null, "save": true, "options": ["Preset", "Custom"] },
    { "param": "ring_text_mode", "label": "Ring Text Mode", "type": "select", "default": 1, "min": 0, "max": 2, "step": 1, "group": "Main", "basic": false, "advanced": true, "audio_target": null, "save": true, "options": ["Presets", "Custom Lanes", "Beat Rotate Lanes"] },
    { "param": "ring_text_1", "label": "Ring Text 1", "type": "select", "default": 6, "min": 0, "max": 6, "step": 1, "group": "Main", "basic": false, "advanced": true, "audio_target": null, "save": true, "options": ["HALO WHO?", "VJLINK", "RAVE", "HARDTECHNO", "VOID?", "GATE?", "BOSO"] },
    { "param": "ring_text_2", "label": "Ring Text 2", "type": "select", "default": 6, "min": 0, "max": 6, "step": 1, "group": "Main", "basic": false, "advanced": true, "audio_target": null, "save": true, "options": ["HALO WHO?", "VJLINK", "RAVE", "HARDTECHNO", "VOID?", "GATE?", "BOSO"] },
    { "param": "ring_text_3", "label": "Ring Text 3", "type": "select", "default": 6, "min": 0, "max": 6, "step": 1, "group": "Main", "basic": false, "advanced": true, "audio_target": null, "save": true, "options": ["HALO WHO?", "VJLINK", "RAVE", "HARDTECHNO", "VOID?", "GATE?", "BOSO"] },
    { "param": "ring_text_4", "label": "Ring Text 4", "type": "select", "default": 6, "min": 0, "max": 6, "step": 1, "group": "Main", "basic": false, "advanced": true, "audio_target": null, "save": true, "options": ["HALO WHO?", "VJLINK", "RAVE", "HARDTECHNO", "VOID?", "GATE?", "BOSO"] },
    { "param": "ring_speed", "label": "Ring Speed", "type": "float", "default": 1.15, "min": -4, "max": 4, "step": 0.01, "group": "Transform", "basic": true, "advanced": false, "audio_target": "mid", "save": true },
    { "param": "ring_radius", "label": "Ring Radius", "type": "float", "default": 0.62, "min": 0.15, "max": 1.4, "step": 0.01, "group": "Transform", "basic": true, "advanced": false, "audio_target": null, "save": true },
    { "param": "perspective", "label": "Perspective", "type": "float", "default": 0.82, "min": 0, "max": 1, "step": 0.01, "group": "Transform", "basic": true, "advanced": false, "audio_target": null, "save": true },
    { "param": "mono_contrast", "label": "Mono Contrast", "type": "float", "default": 1.85, "min": 0.1, "max": 4, "step": 0.05, "group": "Color", "basic": true, "advanced": false, "audio_target": "energy", "save": true },
    { "param": "invert", "label": "Invert", "type": "bool", "default": 0, "min": 0, "max": 1, "step": 1, "group": "Color", "basic": true, "advanced": false, "audio_target": null, "save": true },
    { "param": "smoke", "label": "Smoke", "type": "float", "default": 0.48, "min": 0, "max": 1, "step": 0.01, "group": "Texture/Input", "basic": true, "advanced": false, "audio_target": "rms", "save": true },
    { "param": "scanlines", "label": "Scanlines", "type": "float", "default": 0.74, "min": 0, "max": 1, "step": 0.01, "group": "Glitch", "basic": true, "advanced": false, "audio_target": null, "save": true },
    { "param": "barcode_columns", "label": "Barcode Columns", "type": "float", "default": 0.5, "min": 0, "max": 1, "step": 0.01, "group": "Glitch", "basic": true, "advanced": false, "audio_target": "treble", "save": true },
