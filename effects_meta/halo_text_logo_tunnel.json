    { "param": "glitch_amount", "label": "Glitch Amount", "type": "float", "default": 0.38, "min": 0, "max": 1, "step": 0.01, "group": "Glitch", "basic": true, "advanced": false, "audio_target": "onset", "save": true },
    { "param": "beat_pulse", "label": "Beat Pulse", "type": "float", "default": 0.68, "min": 0, "max": 2, "step": 0.05, "group": "AudioLink", "basic": true, "advanced": false, "audio_target": "beat", "save": true },
    { "param": "audio_glitch", "label": "Audio Glitch", "type": "float", "default": 0.55, "min": 0, "max": 2, "step": 0.05, "group": "AudioLink", "basic": true, "advanced": false, "audio_target": "onset", "save": true },
    { "param": "logo_size", "label": "Logo Size", "type": "float", "default": 0.42, "min": 0.05, "max": 1.2, "step": 0.01, "group": "Transform", "basic": false, "advanced": true, "audio_target": "beat", "save": true },
    { "param": "tunnel_drift", "label": "Tunnel Drift", "type": "float", "default": 0.42, "min": 0, "max": 1.5, "step": 0.01, "group": "Transform", "basic": false, "advanced": true, "audio_target": "low_mid", "save": true },
