{
  "schema_version": 2,
  "effect_id": "logo_extrude_3d",
  "name": "Logo Extrude 3D",
  "category": "3d",
  "role": "generator",
  "performance_group": "logo_fx",
  "quality_cost": "medium",
  "requires_input": false,
  "description": "Turns a 2D logo or input alpha mask into a thick pseudo-3D object with bevel, material shading, glow, and beat bounce.",
  "author": "VJLink",
  "controls": [
    { "param": "logo_slot", "label": "Logo Slot", "type": "select", "default": 0, "min": 0, "max": 2, "step": 1, "group": "Texture/Input", "basic": true, "advanced": false, "audio_target": null, "save": true, "options": ["Logo 1", "Logo 2", "Logo 3"] },
    { "param": "size", "label": "Size", "type": "float", "default": 0.38, "min": 0.05, "max": 1.4, "step": 0.01, "group": "Transform", "basic": true, "advanced": false, "audio_target": null, "save": true },
    { "param": "depth", "label": "Depth", "type": "float", "default": 0.62, "min": 0, "max": 2, "step": 0.01, "group": "Main", "basic": true, "advanced": false, "audio_target": "bass", "save": true },
    { "param": "rotation_x", "label": "Rotation X", "type": "float", "default": -18, "min": -75, "max": 75, "step": 1, "group": "Transform", "basic": true, "advanced": false, "audio_target": null, "save": true },
    { "param": "rotation_y", "label": "Rotation Y", "type": "float", "default": 28, "min": -90, "max": 90, "step": 1, "group": "Transform", "basic": true, "advanced": false, "audio_target": null, "save": true },
    { "param": "rotation_z", "label": "Rotation Z", "type": "float", "default": 0, "min": -180, "max": 180, "step": 1, "group": "Transform", "basic": false, "advanced": true, "audio_target": null, "save": true },
    { "param": "beat_bounce", "label": "Beat Bounce", "type": "bool", "default": 1, "min": 0, "max": 1, "step": 1, "group": "AudioLink", "basic": true, "advanced": false, "audio_target": "beat", "save": true },
    { "param": "audio_react", "label": "Audio React", "type": "float", "default": 0.8, "min": 0, "max": 2, "step": 0.05, "group": "AudioLink", "basic": true, "advanced": false, "audio_target": "energy", "save": true },
    { "param": "material", "label": "Material", "type": "select", "default": 1, "min": 0, "max": 3, "step": 1, "group": "Color", "basic": true, "advanced": false, "audio_target": null, "save": true, "options": ["Plastic", "Chrome", "Matte", "Neon"] },
    { "param": "position_x", "label": "Position X", "type": "float", "default": 0, "min": -1, "max": 1, "step": 0.01, "group": "Transform", "basic": true, "advanced": false, "audio_target": null, "save": true },
    { "param": "position_y", "label": "Position Y", "type": "float", "default": 0, "min": -1, "max": 1, "step": 0.01, "group": "Transform", "basic": true, "advanced": false, "audio_target": null, "save": true },
    { "param": "bevel", "label": "Bevel", "type": "float", "default": 0.32, "min": 0, "max": 1, "step": 0.01, "group": "Main", "basic": false, "advanced": true, "audio_target": null, "save": true },
    { "param": "glow", "label": "Glow", "type": "float", "default": 0.55, "min": 0, "max": 3, "step": 0.05, "group": "Color", "basic": false, "advanced": true, "audio_target": "treble", "save": true },
    { "param": "alpha_threshold", "label": "Alpha Threshold", "type": "float", "default": 0.08, "min": 0, "max": 0.9, "step": 0.01, "group": "Texture/Input", "basic": false, "advanced": true, "audio_target": null, "save": true },
    { "param": "side_light", "label": "Side Light", "type": "float", "default": 0.75, "min": 0, "max": 2, "step": 0.05, "group": "Color", "basic": false, "advanced": true, "audio_target": null, "save": true },
    { "param": "edge_darkness", "label": "Edge Darkness", "type": "float", "default": 0.35, "min": 0, "max": 1, "step": 0.01, "group": "Color", "basic": false, "advanced": true, "audio_target": null, "save": true },
    { "param": "shadow", "label": "Shadow", "type": "float", "default": 0.25, "min": 0, "max": 1, "step": 0.01, "group": "Main", "basic": false, "advanced": true, "audio_target": null, "save": true },
    { "param": "spin_speed", "label": "Spin Speed", "type": "float", "default": 0, "min": -2, "max": 2, "step": 0.01, "group": "Transform", "basic": false, "advanced": true, "audio_target": "mid", "save": true },
    { "param": "auto_rotate", "label": "Auto Rotate", "type": "float", "default": 0.2, "min": 0, "max": 1, "step": 0.01, "group": "Transform", "basic": false, "advanced": true, "audio_target": "energy", "save": true },
    { "param": "perspective", "label": "Perspective", "type": "float", "default": 0.55, "min": 0, "max": 1, "step": 0.01, "group": "Transform", "basic": false, "advanced": true, "audio_target": null, "save": true },
    { "param": "fill_opacity", "label": "Logo Fill", "type": "float", "default": 0.7, "min": 0, "max": 1, "step": 0.01, "group": "Texture/Input", "basic": false, "advanced": true, "audio_target": null, "save": true }
  ],
  "audio_link": {
    "enabled": true,
    "inputs": ["bands", "bands_raw", "beat_phase", "kick_onset", "onset_strength", "rms"],
    "targets": ["depth", "beat_bounce", "audio_react", "glow", "spin_speed", "auto_rotate"]
  },
  "params": [
    { "id": "logo_slot", "name": "Logo Slot", "type": "float", "default": 0, "min": 0, "max": 2, "step": 1 },
    { "id": "depth", "name": "Depth", "type": "float", "default": 0.62, "min": 0, "max": 2, "step": 0.01 },
    { "id": "bevel", "name": "Bevel", "type": "float", "default": 0.32, "min": 0, "max": 1, "step": 0.01 },
    { "id": "size", "name": "Size", "type": "float", "default": 0.38, "min": 0.05, "max": 1.4, "step": 0.01 },
    { "id": "position_x", "name": "Position X", "type": "float", "default": 0, "min": -1, "max": 1, "step": 0.01 },
    { "id": "position_y", "name": "Position Y", "type": "float", "default": 0, "min": -1, "max": 1, "step": 0.01 },
    { "id": "rotation_x", "name": "Rotation X", "type": "float", "default": -18, "min": -75, "max": 75, "step": 1 },
    { "id": "rotation_y", "name": "Rotation Y", "type": "float", "default": 28, "min": -90, "max": 90, "step": 1 },
    { "id": "rotation_z", "name": "Rotation Z", "type": "float", "default": 0, "min": -180, "max": 180, "step": 1 },
    { "id": "beat_bounce", "name": "Beat Bounce", "type": "float", "default": 1, "min": 0, "max": 1, "step": 1 },
    { "id": "audio_react", "name": "Audio React", "type": "float", "default": 0.8, "min": 0, "max": 2, "step": 0.05 },
    { "id": "material", "name": "Material", "type": "float", "default": 1, "min": 0, "max": 3, "step": 1 },
    { "id": "glow", "name": "Glow", "type": "float", "default": 0.55, "min": 0, "max": 3, "step": 0.05 },
    { "id": "alpha_threshold", "name": "Alpha Threshold", "type": "float", "default": 0.08, "min": 0, "max": 0.9, "step": 0.01 },
    { "id": "side_light", "name": "Side Light", "type": "float", "default": 0.75, "min": 0, "max": 2, "step": 0.05 },
    { "id": "edge_darkness", "name": "Edge Darkness", "type": "float", "default": 0.35, "min": 0, "max": 1, "step": 0.01 },
    { "id": "shadow", "name": "Shadow", "type": "float", "default": 0.25, "min": 0, "max": 1, "step": 0.01 },
    { "id": "spin_speed", "name": "Spin Speed", "type": "float", "default": 0, "min": -2, "max": 2, "step": 0.01 },
    { "id": "auto_rotate", "name": "Auto Rotate", "type": "float", "default": 0.2, "min": 0, "max": 1, "step": 0.01 },
    { "id": "perspective", "name": "Perspective", "type": "float", "default": 0.55, "min": 0, "max": 1, "step": 0.01 },
    { "id": "fill_opacity", "name": "Logo Fill", "type": "float", "default": 0.7, "min": 0, "max": 1, "step": 0.01 }
  ]
}
