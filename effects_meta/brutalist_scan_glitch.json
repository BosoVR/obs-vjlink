{
  "schema_version": 2,
  "effect_id": "brutalist_scan_glitch",
  "name": "Brutalist Scan Glitch",
  "category": "glitch",
  "role": "postprocess",
  "performance_group": "post_glitch",
  "quality_cost": "low",
  "requires_input": false,
  "description": "Reusable monochrome scan glitch for live content with horizontal tearing, barcode columns, frame smear, crushed contrast, smoke noise, and a procedural fallback when no source is connected.",
  "author": "VJLink",
  "controls": [
    { "param": "mix", "label": "Mix", "type": "float", "default": 0.72, "min": 0, "max": 1, "step": 0.01, "group": "Main", "basic": true, "advanced": false, "audio_target": "energy", "save": true },
    { "param": "horizontal_tear", "label": "Horizontal Tear", "type": "float", "default": 0.52, "min": 0, "max": 1, "step": 0.01, "group": "Glitch", "basic": true, "advanced": false, "audio_target": "onset", "save": true },
    { "param": "vertical_scan_columns", "label": "Vertical Scan Columns", "type": "float", "default": 0.58, "min": 0, "max": 1, "step": 0.01, "group": "Glitch", "basic": true, "advanced": false, "audio_target": "treble", "save": true },
    { "param": "frame_smear", "label": "Frame Smear", "type": "float", "default": 0.22, "min": 0, "max": 1, "step": 0.01, "group": "Glitch", "basic": true, "advanced": false, "audio_target": "low_mid", "save": true },
    { "param": "black_crush", "label": "Black Crush", "type": "float", "default": 0.34, "min": 0, "max": 1, "step": 0.01, "group": "Color", "basic": true, "advanced": false, "audio_target": null, "save": true },
    { "param": "white_clip", "label": "White Clip", "type": "float", "default": 0.22, "min": 0, "max": 1, "step": 0.01, "group": "Color", "basic": true, "advanced": false, "audio_target": null, "save": true },
    { "param": "noise_smoke", "label": "Noise Smoke", "type": "float", "default": 0.42, "min": 0, "max": 1, "step": 0.01, "group": "Texture/Input", "basic": true, "advanced": false, "audio_target": "rms", "save": true },
    { "param": "beat_hit", "label": "Beat Hit", "type": "float", "default": 0.8, "min": 0, "max": 2, "step": 0.05, "group": "AudioLink", "basic": true, "advanced": false, "audio_target": "beat", "save": true },
    { "param": "snare_hit", "label": "Snare Hit", "type": "float", "default": 0.65, "min": 0, "max": 2, "step": 0.05, "group": "AudioLink", "basic": true, "advanced": false, "audio_target": "snare", "save": true },
    { "param": "text_safe_mode", "label": "Text-Safe Mode", "type": "bool", "default": 0, "min": 0, "max": 1, "step": 1, "group": "Main", "basic": true, "advanced": false, "audio_target": null, "save": true },
    { "param": "scanline_density", "label": "Scanline Density", "type": "float", "default": 0.35, "min": 0, "max": 1, "step": 0.01, "group": "Glitch", "basic": false, "advanced": true, "audio_target": null, "save": true },
    { "param": "invert", "label": "Invert", "type": "bool", "default": 0, "min": 0, "max": 1, "step": 1, "group": "Color", "basic": false, "advanced": true, "audio_target": null, "save": true },
    { "param": "fallback_alpha", "label": "Fallback Alpha", "type": "float", "default": 1, "min": 0, "max": 1, "step": 0.01, "group": "Texture/Input", "basic": false, "advanced": true, "audio_target": null, "save": true }
  ],
  "audio_link": {
    "enabled": true,
    "inputs": ["bands", "bands_raw", "beat_phase", "kick_onset", "snare_onset", "onset_strength", "rms"],
    "targets": ["mix", "horizontal_tear", "vertical_scan_columns", "frame_smear", "noise_smoke", "beat_hit", "snare_hit"]
  },
  "params": [
    { "id": "mix", "name": "Mix", "type": "float", "default": 0.72, "min": 0, "max": 1, "step": 0.01 },
    { "id": "horizontal_tear", "name": "Horizontal Tear", "type": "float", "default": 0.52, "min": 0, "max": 1, "step": 0.01 },
    { "id": "vertical_scan_columns", "name": "Vertical Scan Columns", "type": "float", "default": 0.58, "min": 0, "max": 1, "step": 0.01 },
    { "id": "frame_smear", "name": "Frame Smear", "type": "float", "default": 0.22, "min": 0, "max": 1, "step": 0.01 },
    { "id": "black_crush", "name": "Black Crush", "type": "float", "default": 0.34, "min": 0, "max": 1, "step": 0.01 },
    { "id": "white_clip", "name": "White Clip", "type": "float", "default": 0.22, "min": 0, "max": 1, "step": 0.01 },
    { "id": "noise_smoke", "name": "Noise Smoke", "type": "float", "default": 0.42, "min": 0, "max": 1, "step": 0.01 },
    { "id": "beat_hit", "name": "Beat Hit", "type": "float", "default": 0.8, "min": 0, "max": 2, "step": 0.05 },
    { "id": "snare_hit", "name": "Snare Hit", "type": "float", "default": 0.65, "min": 0, "max": 2, "step": 0.05 },
    { "id": "text_safe_mode", "name": "Text-Safe Mode", "type": "float", "default": 0, "min": 0, "max": 1, "step": 1 },
    { "id": "scanline_density", "name": "Scanline Density", "type": "float", "default": 0.35, "min": 0, "max": 1, "step": 0.01 },
    { "id": "invert", "name": "Invert", "type": "float", "default": 0, "min": 0, "max": 1, "step": 1 },
    { "id": "fallback_alpha", "name": "Fallback Alpha", "type": "float", "default": 1, "min": 0, "max": 1, "step": 0.01 }
  ]
}
