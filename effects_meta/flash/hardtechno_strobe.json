{
  "id": "hardtechno_strobe",
  "name": "Hardtechno Strobe Reactor",
  "category": "flash",
  "role": "overlay",
  "requires_input": false,
  "performance_group": "band_trigger",
  "params": [
    { "name": "source_band", "label": "Source Band", "type": "float", "default": 4.0, "min": 0.0, "max": 5.0, "step": 1.0 },
    { "name": "threshold", "label": "Trigger Threshold", "type": "float", "default": 0.55, "min": 0.0, "max": 1.0, "step": 0.01 },
    { "name": "sensitivity", "label": "Sensitivity", "type": "float", "default": 1.25, "min": 0.1, "max": 5.0, "step": 0.01 },
    { "name": "brightness", "label": "Brightness", "type": "float", "default": 1.25, "min": 0.0, "max": 3.0, "step": 0.01 },
    { "name": "flash_rate", "label": "Flash Rate", "type": "float", "default": 18.0, "min": 0.25, "max": 40.0, "step": 0.05 },
    { "name": "pulse_width", "label": "Pulse Width", "type": "float", "default": 0.16, "min": 0.02, "max": 0.95, "step": 0.01 },
    { "name": "mode", "label": "Mode", "type": "float", "default": 1.0, "min": 0.0, "max": 3.0, "step": 1.0 },
    { "name": "color_burst", "label": "Color Burst", "type": "float", "default": 0.35, "min": 0.0, "max": 1.0, "step": 0.01 },
    { "name": "color_burst_chance", "label": "Burst Chance", "type": "float", "default": 0.28, "min": 0.0, "max": 1.0, "step": 0.01 },
    { "name": "invert_amount", "label": "Invert Amount", "type": "float", "default": 0.0, "min": 0.0, "max": 1.0, "step": 0.01 },
    { "name": "text_logo_peak", "label": "Logo on Peak", "type": "float", "default": 0.0, "min": 0.0, "max": 1.0, "step": 0.01 },
    { "name": "grid_slices", "label": "Grid Slices", "type": "float", "default": 12.0, "min": 1.0, "max": 80.0, "step": 1.0 },
    { "name": "shake_amount", "label": "Shake", "type": "float", "default": 0.35, "min": 0.0, "max": 1.0, "step": 0.01 },
    { "name": "source_mix", "label": "Source Mix", "type": "float", "default": 0.0, "min": 0.0, "max": 1.0, "step": 0.01 },
    { "name": "safety_enable", "label": "Safety Limit", "type": "float", "default": 1.0, "min": 0.0, "max": 1.0, "step": 1.0 },
    { "name": "black_ratio", "label": "Black Ratio", "type": "float", "default": 0.18, "min": 0.0, "max": 0.9, "step": 0.01 }
  ]
}
