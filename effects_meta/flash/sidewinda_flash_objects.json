{
  "schema_version": 2,
  "effect_id": "sidewinda_flash_objects",
  "name": "Sidewinda Flash Objects",
  "category": "flash",
  "role": "generator",
  "performance_group": "pad_flash",
  "quality_cost": "medium",
  "requires_input": false,
  "description": "Hard monochrome audio-reactive flash background with torn horizontal bands, smoky noise, and optional 3D-ish logo, primitive, or mesh-like silhouettes.",
  "author": "VJLink",
  "controls": [
    { "param": "flash_intensity", "label": "Flash", "type": "float", "default": 0.75, "min": 0, "max": 1, "step": 0.01, "group": "Main", "basic": true, "advanced": false, "audio_target": "kick", "save": true },
    { "param": "audio_react", "label": "Audio React", "type": "float", "default": 1.0, "min": 0, "max": 2, "step": 0.05, "group": "AudioLink", "basic": true, "advanced": false, "audio_target": "onset", "save": true },
    { "param": "flash_rate", "label": "Flash Rate", "type": "float", "default": 12, "min": 0.25, "max": 30, "step": 0.05, "group": "Main", "basic": true, "advanced": false, "audio_target": "beat", "save": true },
    { "param": "object_mode", "label": "Object Mode", "type": "select", "default": 0, "min": 0, "max": 3, "step": 1, "group": "Transform", "basic": true, "advanced": false, "audio_target": null, "save": true, "options": ["Off", "Logo", "Primitive", "Mesh"] },
    { "param": "object_count", "label": "Objects", "type": "float", "default": 3, "min": 0, "max": 12, "step": 1, "group": "Transform", "basic": true, "advanced": false, "audio_target": null, "save": true },
    { "param": "glitch", "label": "Glitch", "type": "float", "default": 0.45, "min": 0, "max": 1, "step": 0.01, "group": "Glitch", "basic": true, "advanced": false, "audio_target": "onset", "save": true },
    { "param": "contrast", "label": "Contrast", "type": "float", "default": 1.8, "min": 0.2, "max": 4, "step": 0.05, "group": "Color", "basic": true, "advanced": false, "audio_target": null, "save": true },
    { "param": "band_density", "label": "Band Density", "type": "float", "default": 0.55, "min": 0, "max": 1, "step": 0.01, "group": "Glitch", "basic": false, "advanced": true, "audio_target": "mid", "save": true },
    { "param": "tear_amount", "label": "Horizontal Tear", "type": "float", "default": 0.62, "min": 0, "max": 1, "step": 0.01, "group": "Glitch", "basic": false, "advanced": true, "audio_target": "onset", "save": true },
    { "param": "smoke_density", "label": "Smoke", "type": "float", "default": 0.58, "min": 0, "max": 1, "step": 0.01, "group": "Texture/Input", "basic": false, "advanced": true, "audio_target": "rms", "save": true },
    { "param": "object_scale", "label": "Object Scale", "type": "float", "default": 1.0, "min": 0.2, "max": 3, "step": 0.01, "group": "Transform", "basic": false, "advanced": true, "audio_target": "beat", "save": true },
    { "param": "object_spin", "label": "Object Spin", "type": "float", "default": 0.75, "min": -3, "max": 3, "step": 0.01, "group": "Transform", "basic": false, "advanced": true, "audio_target": "mid", "save": true },
    { "param": "object_depth", "label": "Depth Pulse", "type": "float", "default": 0.65, "min": 0, "max": 2, "step": 0.05, "group": "Transform", "basic": false, "advanced": true, "audio_target": "kick", "save": true },
    { "param": "logo_slot", "label": "Logo Slot", "type": "select", "default": 0, "min": 0, "max": 2, "step": 1, "group": "Texture/Input", "basic": false, "advanced": true, "audio_target": null, "save": true, "options": ["Logo 1", "Logo 2", "Logo 3"] },
    { "param": "source_mix", "label": "Source Mix", "type": "float", "default": 0, "min": 0, "max": 1, "step": 0.01, "group": "Texture/Input", "basic": false, "advanced": true, "audio_target": null, "save": true },
    { "param": "invert", "label": "Invert", "type": "bool", "default": 0, "min": 0, "max": 1, "step": 1, "group": "Color", "basic": false, "advanced": true, "audio_target": null, "save": true },
    { "param": "safety_enable", "label": "Strobe Safety", "type": "bool", "default": 1, "min": 0, "max": 1, "step": 1, "group": "Performance", "basic": false, "advanced": true, "audio_target": null, "save": true }
  ],
  "audio_link": {
