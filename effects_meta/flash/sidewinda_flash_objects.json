    { "id": "glitch", "name": "Glitch", "type": "float", "default": 0.45, "min": 0, "max": 1, "step": 0.01 },
    { "id": "contrast", "name": "Contrast", "type": "float", "default": 1.8, "min": 0.2, "max": 4, "step": 0.05 },
    { "id": "band_density", "name": "Band Density", "type": "float", "default": 0.55, "min": 0, "max": 1, "step": 0.01 },
    { "id": "tear_amount", "name": "Horizontal Tear", "type": "float", "default": 0.62, "min": 0, "max": 1, "step": 0.01 },
    { "id": "smoke_density", "name": "Smoke", "type": "float", "default": 0.58, "min": 0, "max": 1, "step": 0.01 },
    { "id": "object_scale", "name": "Object Scale", "type": "float", "default": 1.0, "min": 0.2, "max": 3, "step": 0.01 },
    { "id": "object_spin", "name": "Object Spin", "type": "float", "default": 0.75, "min": -3, "max": 3, "step": 0.01 },
    { "id": "object_depth", "name": "Depth Pulse", "type": "float", "default": 0.65, "min": 0, "max": 2, "step": 0.05 },
    { "id": "logo_slot", "name": "Logo Slot", "type": "float", "default": 0, "min": 0, "max": 2, "step": 1 },
    { "id": "source_mix", "name": "Source Mix", "type": "float", "default": 0, "min": 0, "max": 1, "step": 0.01 },
    { "id": "invert", "name": "Invert", "type": "float", "default": 0, "min": 0, "max": 1, "step": 1 },
    { "id": "safety_enable", "name": "Strobe Safety", "type": "float", "default": 1, "min": 0, "max": 1, "step": 1 }
  ]
