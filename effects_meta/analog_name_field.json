    "inputs": ["bands", "bands_raw", "beat_phase", "kick_onset", "snare_onset", "onset_strength", "rms"],
    "targets": ["text_spread", "drift_speed", "rotation_speed", "line_density", "glitch_amount", "tear_amount", "bloom_amount", "mono_contrast", "flicker", "smoke", "audio_react"]
