    { "param": "tear_amount", "label": "Horizontal Tear", "type": "float", "default": 0.42, "min": 0, "max": 1, "step": 0.01, "group": "Glitch", "basic": true, "advanced": false, "audio_target": "kick", "save": true },
    { "param": "scanlines", "label": "Scanlines", "type": "float", "default": 0.72, "min": 0, "max": 1, "step": 0.01, "group": "Glitch", "basic": true, "advanced": false, "audio_target": null, "save": true },
    { "param": "depth_blur", "label": "Depth Blur", "type": "float", "default": 0.68, "min": 0, "max": 1.5, "step": 0.01, "group": "Main", "basic": false, "advanced": true, "audio_target": null, "save": true },
    { "param": "bloom_amount", "label": "Bloom", "type": "float", "default": 0.62, "min": 0, "max": 2, "step": 0.01, "group": "Color", "basic": false, "advanced": true, "audio_target": "kick", "save": true },
    { "param": "mono_contrast", "label": "Mono Contrast", "type": "float", "default": 2.3, "min": 0.2, "max": 5, "step": 0.05, "group": "Color", "basic": true, "advanced": false, "audio_target": "energy", "save": true },
    { "param": "flicker", "label": "Signal Flicker", "type": "float", "default": 0.45, "min": 0, "max": 1.5, "step": 0.01, "group": "Glitch", "basic": false, "advanced": true, "audio_target": "onset", "save": true },
    { "param": "smoke", "label": "Smoke Haze", "type": "float", "default": 0.42, "min": 0, "max": 1, "step": 0.01, "group": "Texture/Input", "basic": false, "advanced": true, "audio_target": "rms", "save": true },
    { "param": "invert", "label": "Invert", "type": "bool", "default": 0, "min": 0, "max": 1, "step": 1, "group": "Color", "basic": false, "advanced": true, "audio_target": null, "save": true, "options": ["Off", "On"] },
