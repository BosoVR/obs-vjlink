{
  "schema_version": 2,
  "effect_id": "analog_name_field",
  "name": "Analog Name Field",
  "category": "geometric",
  "role": "generator",
  "performance_group": "main_visual",
  "quality_cost": "low",
  "requires_input": false,
  "description": "Monochrome drifting name field with rotating slit lines, CRT flicker, bloom, and AudioLink response.",
  "author": "VJLink",
  "controls": [
    { "param": "main_text", "label": "Main Text", "type": "select", "default": 0, "min": 0, "max": 5, "step": 1, "group": "Main", "basic": true, "advanced": false, "audio_target": null, "save": true, "options": ["BOSO", "VJLINK", "RAVE", "HARDTECHNO", "VOID?", "GATE?"] },
    { "param": "alt_text", "label": "Alt Text", "type": "select", "default": 3, "min": 0, "max": 5, "step": 1, "group": "Main", "basic": true, "advanced": false, "audio_target": null, "save": true, "options": ["BOSO", "VJLINK", "RAVE", "HARDTECHNO", "VOID?", "GATE?"] },
    { "param": "name_layers", "label": "Name Layers", "type": "float", "default": 7, "min": 1, "max": 8, "step": 1, "group": "Main", "basic": true, "advanced": false, "audio_target": null, "save": true },
    { "param": "text_scale", "label": "Text Size", "type": "float", "default": 0.78, "min": 0.25, "max": 2.0, "step": 0.01, "group": "Main", "basic": true, "advanced": false, "audio_target": null, "save": true },
    { "param": "text_spread", "label": "Depth Spread", "type": "float", "default": 0.72, "min": 0.05, "max": 1.6, "step": 0.01, "group": "Main", "basic": true, "advanced": false, "audio_target": "mid", "save": true },
    { "param": "drift_speed", "label": "Drift Speed", "type": "float", "default": 1.0, "min": -3, "max": 3, "step": 0.01, "group": "Transform", "basic": true, "advanced": false, "audio_target": "low_mid", "save": true },
    { "param": "rotation_speed", "label": "Rotation Speed", "type": "float", "default": 0.62, "min": -3, "max": 3, "step": 0.01, "group": "Transform", "basic": true, "advanced": false, "audio_target": "mid", "save": true },
    { "param": "line_density", "label": "Line Density", "type": "float", "default": 72, "min": 8, "max": 180, "step": 1, "group": "Transform", "basic": true, "advanced": false, "audio_target": "treble", "save": true },
    { "param": "line_width", "label": "Line Width", "type": "float", "default": 0.16, "min": 0.02, "max": 0.45, "step": 0.01, "group": "Transform", "basic": true, "advanced": false, "audio_target": null, "save": true },
    { "param": "line_rotation", "label": "Line Rotation", "type": "float", "default": 0.10, "min": -3.14, "max": 3.14, "step": 0.01, "group": "Transform", "basic": false, "advanced": true, "audio_target": null, "save": true },
