    { "id": "alt_text", "name": "Alt Text", "type": "float", "default": 3, "min": 0, "max": 5, "step": 1 },
    { "id": "name_layers", "name": "Name Layers", "type": "float", "default": 7, "min": 1, "max": 8, "step": 1 },
    { "id": "text_scale", "name": "Text Size", "type": "float", "default": 0.78, "min": 0.25, "max": 2.0, "step": 0.01 },
    { "id": "text_spread", "name": "Depth Spread", "type": "float", "default": 0.72, "min": 0.05, "max": 1.6, "step": 0.01 },
    { "id": "drift_speed", "name": "Drift Speed", "type": "float", "default": 1.0, "min": -3, "max": 3, "step": 0.01 },
    { "id": "rotation_speed", "name": "Rotation Speed", "type": "float", "default": 0.62, "min": -3, "max": 3, "step": 0.01 },
    { "id": "line_density", "name": "Line Density", "type": "float", "default": 72, "min": 8, "max": 180, "step": 1 },
    { "id": "line_width", "name": "Line Width", "type": "float", "default": 0.16, "min": 0.02, "max": 0.45, "step": 0.01 },
    { "id": "line_rotation", "name": "Line Rotation", "type": "float", "default": 0.10, "min": -3.14, "max": 3.14, "step": 0.01 },
    { "id": "glitch_amount", "name": "Glitch", "type": "float", "default": 0.34, "min": 0, "max": 1, "step": 0.01 },
    { "id": "tear_amount", "name": "Horizontal Tear", "type": "float", "default": 0.42, "min": 0, "max": 1, "step": 0.01 },
    { "id": "scanlines", "name": "Scanlines", "type": "float", "default": 0.72, "min": 0, "max": 1, "step": 0.01 },
    { "id": "depth_blur", "name": "Depth Blur", "type": "float", "default": 0.68, "min": 0, "max": 1.5, "step": 0.01 },
    { "id": "bloom_amount", "name": "Bloom", "type": "float", "default": 0.62, "min": 0, "max": 2, "step": 0.01 },
    { "id": "mono_contrast", "name": "Mono Contrast", "type": "float", "default": 2.3, "min": 0.2, "max": 5, "step": 0.05 },
    { "id": "flicker", "name": "Signal Flicker", "type": "float", "default": 0.45, "min": 0, "max": 1.5, "step": 0.01 },
    { "id": "smoke", "name": "Smoke Haze", "type": "float", "default": 0.42, "min": 0, "max": 1, "step": 0.01 },
    { "id": "invert", "name": "Invert", "type": "float", "default": 0, "min": 0, "max": 1, "step": 1 },
    { "id": "audio_react", "name": "Audio React", "type": "float", "default": 1.0, "min": 0, "max": 3, "step": 0.01 },
    { "id": "noise_seed", "name": "Noise Seed", "type": "float", "default": 29, "min": 0, "max": 999, "step": 1 }
  ]
