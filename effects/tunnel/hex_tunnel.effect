/*
 * VJLink - Hex Tunnel (Pro v2)
 * Forward-flying hex grid tunnel with palette accent, beat-driven cell pulse,
 * audio-reactive scale and forward speed.
 */

uniform float4x4 ViewProj;
uniform texture2d audio_tex;
uniform float2    resolution;
uniform float     time;
uniform float4    bands;
uniform float4    bands_raw;
uniform float     beat_phase;
uniform float     beat_1_4;
uniform float     beat_1_8;
uniform float     kick_onset;
uniform float     onset_strength;
uniform float     palette_id;

uniform float hex_scale;          /* 0.5 - 6, default 2.5 */
uniform float tunnel_speed;       /* 0.1 - 5, default 1.2 */
uniform float glow_width;         /* 0.005 - 0.15, default 0.04 */
uniform float color_cycle;        /* 0 - 2, default 0.4 */
uniform float audio_drive;        /* 0 - 2, default 1.0 */
uniform float beat_sync;          /* 0=off 1=1/4 2=1/8 */

sampler_state texSampler { Filter = Linear; AddressU = Clamp; AddressV = Clamp; };
struct VertInOut { float4 pos : POSITION; float2 uv : TEXCOORD0; };

VertInOut VSDefault(VertInOut vert_in)
{
    VertInOut o;
    o.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
    o.uv = vert_in.uv;
    return o;
}

float hash21(float2 p) { p = frac(p * float2(123.34, 456.21)); p += dot(p, p + 45.32); return frac(p.x * p.y); }

float3 palette_hex(int pid, float t) {
    if (pid == 1) return 0.5 + 0.5 * cos(6.28318 * (float3(1.0,0.3,0.2) * t + float3(0.0, 0.12, 0.18)));
    if (pid == 2) return 0.5 + 0.5 * cos(6.28318 * (float3(1.0,0.6,0.2) * t + float3(0.0, 0.18, 0.32)));
    if (pid == 3) return 0.5 + 0.5 * cos(6.28318 * (float3(0.55,1.0,0.5) * t + float3(0.25, 0.32, 0.18)));
    if (pid == 4) return 0.5 + 0.5 * cos(6.28318 * (float3(0.6,1.0,1.0) * t + float3(0.55, 0.25, 0.1)));
    if (pid == 5) { float v = pow(t, 1.5); return float3(v, v, v); }
    return 0.5 + 0.5 * cos(6.28318 * (float3(1.0,1.0,1.0) * t + float3(0.0, 0.33, 0.67)));
}

float3 hsv2rgb(float3 c)
{
    float4 K = float4(1.0, 2.0/3.0, 1.0/3.0, 3.0);
    float3 p = abs(frac(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * lerp(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

/* Hex grid distance + cell ID */
float2 hexCell(float2 p, out float2 id)
{
    float2 H = float2(1.0, 1.7320508);
    float2 a = fmod(p, H) - H * 0.5;
    float2 b = fmod(p + H * 0.5, H) - H * 0.5;
    float2 ab = dot(a, a) < dot(b, b) ? a : b;
    id = p - ab;
    /* Distance to nearest hex edge */
    float2 abs_a = abs(ab);
    float ed = max(abs_a.x * 0.866 + abs_a.y * 0.5, abs_a.y);
    return float2(0.5 - ed, 0.0); /* distance to edge */
}

float4 PSHexTunnel(VertInOut vert_in) : TARGET
{
    float2 uv = vert_in.uv;
    float2 p = (uv - 0.5) * 2.0;
    p.x *= resolution.x / max(resolution.y, 1.0);

    float drive   = max(audio_drive, 0.0);
    float bass    = bands.x * drive;
    float lowmid  = bands.y * drive;
    float highmid = bands.z * drive;
    float treble  = bands.w * drive;
    float kick    = kick_onset * drive;
    float onset   = onset_strength * drive;

    float bs = beat_sync;
    float beat = pow(1.0 - beat_phase, 3.0);
    float beat_q = (bs < 0.5) ? 0.0
                  : (bs < 1.5 ? pow(1.0 - beat_1_4, 4.0)
                              : pow(1.0 - beat_1_8, 4.0));

    float scale = max(hex_scale, 2.0);
    float speed = tunnel_speed + bass * 0.8 + kick * 0.25;
    float glow = max(glow_width, 0.01);

    float r = length(p);
    float a = atan2(p.y, p.x);
    float inv_r = 1.0 / (r + 0.001);

    float cam_rot = time * 0.15 * speed + bass * 0.3;
    a += cam_rot;

    float depth = inv_r;
    float2 tp;
    tp.x = a / 3.14159 * scale;
    tp.y = depth * scale * 0.5 + time * speed * 2.0;

    float3 col = float3(0.0, 0.0, 0.0);

    for (int layer = 0; layer < 3; layer++) {
        float layer_f = (float)layer;
        float layer_offset = layer_f * 0.3;
        float layer_scale = 1.0 + layer_f * 0.5;
        float layer_alpha = 1.0 - layer_f * 0.3;

        float2 lp = tp * layer_scale + float2(layer_offset, layer_offset * 1.7);
        float2 hex_id;
        float2 hex_d = hexCell(lp, hex_id);
        float edge_dist = hex_d.x;

        float seed = hash21(hex_id);
        float edge_abs = abs(edge_dist);
        float edge_glow = exp(-edge_abs / (glow * (1.0 + bass * 0.5))) * 0.9;

        float band_sel = frac(seed * 4.0);
        float cell_energy = (band_sel < 0.25) ? bass
                          : (band_sel < 0.5) ? lowmid
                          : (band_sel < 0.75) ? highmid : treble;

        float inner_glow = smoothstep(0.18, 0.02, edge_abs) * cell_energy * 0.35;
        inner_glow += smoothstep(0.24, 0.02, edge_abs) * beat_q * bass * 0.28;

        float hue = frac(seed * 0.7 + time * color_cycle * 0.1 + hex_id.y * 0.02);
        float3 cell_color = palette_hex((int)palette_id, hue);

        float depth_fade = exp(-r * 1.5) * (1.0 + layer_f * 0.3);
        depth_fade = saturate(depth_fade * 2.0);

        col += cell_color * (edge_glow + inner_glow) * depth_fade * layer_alpha;
    }

    float core = exp(-r * 8.0) * 0.3;
    float core_hue = frac(time * 0.15 + bass * 0.2);
    col += palette_hex((int)palette_id, core_hue) * core * (1.0 + bass);

    float scanline = sin(a * 12.0 + time * 3.0) * 0.5 + 0.5;
    scanline = pow(scanline, 8.0) * 0.1 * treble;
    col += float3(0.3, 0.6, 1.0) * scanline * exp(-r * 2.0);

    float beat_flash = beat_q * bass * exp(-r * 3.0) * 0.6;
    col += float3(1.0, 0.95, 0.9) * beat_flash;
    col += float3(1.0, 1.0, 1.0) * onset * exp(-r * 2.5) * 0.12;

    col = col / (1.0 + col * 0.28);
    col *= saturate(1.0 - r * 0.15);

    col = pow(saturate(col), float3(0.9, 0.9, 0.9));
    return float4(col, 1.0);
}

technique Draw {
    pass {
        vertex_shader = VSDefault(vert_in);
        pixel_shader = PSHexTunnel(vert_in);
    }
}
