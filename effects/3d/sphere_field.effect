/*
 * VJLink Sphere Field Effect
 * Raymarched finite field of spheres with audio-reactive pulsing.
 * Restores the original orbiting 3D stage look with newer audio uniforms.
 */

uniform float4x4 ViewProj;
uniform texture2d audio_tex;
uniform float2    resolution;
uniform float     time;
uniform float4    bands;
uniform float4    bands_raw;
uniform float     beat_phase;
uniform float     beat_1_4;
uniform float     kick_onset;
uniform float     onset_strength;
uniform float     palette_id;

uniform float sphere_count;       /* 2 - 20, default 8 (visual density only) */
uniform float sphere_spacing;     /* 0.5 - 5, default 2.0 */
uniform float cam_distance;       /* 1 - 10, default 5.0 */
uniform float glow_intensity;     /* 0 - 3, default 1.2 */
uniform float audio_drive;        /* 0 - 2, default 1.0 */
uniform float rotation_speed;     /* 0 - 1, default 0.08 */
uniform float rotation_axis;      /* 0=Y orbit, 1=X orbit, 2=Z roll */
uniform float rotation_audio;     /* 0 - 1 */
uniform float pulse_amount;       /* 0 - 1 */
uniform float camera_height;      /* -4 - 4 */
uniform float ray_steps;          /* 24 - 96 */

sampler_state texSampler { Filter = Linear; AddressU = Clamp; AddressV = Clamp; };
struct VertInOut { float4 pos : POSITION; float2 uv : TEXCOORD0; };

VertInOut VSDefault(VertInOut vert_in)
{
    VertInOut o;
    o.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
    o.uv = vert_in.uv;
    return o;
}

float3 palette_sphere(int pid, float t) {
    if (pid == 1) return 0.5 + 0.5 * cos(6.28318 * (float3(1.0,0.3,0.2) * t + float3(0.0, 0.12, 0.18)));
    if (pid == 2) return 0.5 + 0.5 * cos(6.28318 * (float3(1.0,0.6,0.2) * t + float3(0.0, 0.18, 0.32)));
    if (pid == 3) return 0.5 + 0.5 * cos(6.28318 * (float3(0.55,1.0,0.5) * t + float3(0.25, 0.32, 0.18)));
    if (pid == 4) return 0.5 + 0.5 * cos(6.28318 * (float3(0.6,1.0,1.0) * t + float3(0.55, 0.25, 0.1)));
    if (pid == 5) { float v = pow(t, 1.5); return float3(v, v, v); }
    return 0.5 + 0.5 * cos(6.28318 * (float3(1.0,1.0,1.0) * t + float3(0.0, 0.33, 0.67)));
}

float sdSphere(float3 p, float r) { return length(p) - r; }

float sceneSDF(float3 p)
{
    float grid = max(sphere_spacing, 1.0);
    float count = max(sphere_count, 2.0);

    /* Repeat space inside a bounded field. The finite bound was the part
     * that made the early version read as an object in a 3D scene. */
    float3 q = p;
    q.xz = fmod(abs(q.xz) + grid * 0.5, grid) - grid * 0.5;
    q.y  = fmod(abs(q.y) + grid * 0.5, grid) - grid * 0.5;

    /* Audio-reactive radius */
    float ad = max(audio_drive, 0.0);
    float base_r = 0.4 + bands.x * 0.4 * ad * saturate(pulse_amount);
    float beat = 1.0 - beat_phase;
    beat = beat * beat;
    base_r += (beat * 0.2 + kick_onset * 0.16) * saturate(pulse_amount) * ad;

    float bound = count * grid * 0.5;
    float box = max(max(abs(p.x) - bound, abs(p.y) - bound), abs(p.z) - bound);

    return max(sdSphere(q, base_r), box);
}

float3 calcNormal(float3 p)
{
    float2 e = float2(0.001, 0.0);
    return normalize(float3(
        sceneSDF(p + e.xyy) - sceneSDF(p - e.xyy),
        sceneSDF(p + e.yxy) - sceneSDF(p - e.yxy),
        sceneSDF(p + e.yyx) - sceneSDF(p - e.yyx)
    ));
}

float4 PSSphereField(VertInOut vert_in) : TARGET
{
    float2 uv = vert_in.uv;
    float2 p = (uv - 0.5) * 2.0;
    p.x *= resolution.x / max(resolution.y, 1.0);

    float dist = max(cam_distance, 3.0);
    float ad = max(audio_drive, 0.0);
    float bass = bands.x * ad;
    float lowmid = bands.y * ad;
    float highmid = bands.z * ad;
    float treble = bands.w * ad;
    float kick = kick_onset * ad;
    float onset = onset_strength * ad;

    float rot_audio = saturate(rotation_audio) * ad;
    float angle = time * (max(rotation_speed, 0.0) + lowmid * 0.08 * rot_audio + kick * 0.05 * rot_audio);
    float height = camera_height + sin(time * 0.2) * 0.25 * rot_audio;
    int axis = (int)floor(rotation_axis + 0.5);
    float3 ro;
    if (axis == 1) {
        ro = float3(0.0, cos(angle) * dist * 0.45 + height, sin(angle) * dist);
    } else if (axis == 2) {
        ro = float3(cos(angle) * dist, height + sin(angle * 0.5) * 0.8, sin(angle) * dist);
        p = float2(p.x * cos(angle * 0.35) - p.y * sin(angle * 0.35),
                   p.x * sin(angle * 0.35) + p.y * cos(angle * 0.35));
    } else {
        ro = float3(cos(angle) * dist, 2.0 + height, sin(angle) * dist);
    }
    float3 ta = float3(0.0, 0.0, 0.0);

    float3 ww = normalize(ta - ro);
    float3 uu = normalize(cross(ww, float3(0.0, 1.0, 0.0)));
    float3 vv = cross(uu, ww);
    float3 rd = normalize(p.x * uu + p.y * vv + 1.5 * ww);

    /* Raymarch */
    float t = 0.0;
    float3 color = float3(0.0, 0.0, 0.0);
    float glow = 0.0;

    int max_steps = (int)clamp(floor(ray_steps + 0.5), 24.0, 96.0);
    for (int i = 0; i < 96; i++) {
        if (i >= max_steps) break;
        float3 pos = ro + rd * t;
        float d = sceneSDF(pos);

        /* Accumulate the old surface glow, with a small onset lift. */
        glow += 0.02 / (0.1 + d * d);

        if (d < 0.002) {
            float3 n = calcNormal(pos);
            float3 light_dir = normalize(float3(0.5, 0.8, -0.3));
            float diff = max(dot(n, light_dir), 0.0);
            float spec = pow(max(dot(reflect(-light_dir, n), -rd), 0.0), 32.0 + treble * 24.0);

            float hue = frac(length(pos.xz) * 0.1 + time * 0.1 + lowmid * 0.5);
            float3 base_col = palette_sphere((int)palette_id, hue);

            color = base_col * (diff * 0.8 + 0.2) + float3(1.0, 1.0, 1.0) * spec * 0.5;
            color += base_col * (kick * 0.25 + onset * 0.12);
            break;
        }

        t += d;
        if (t > 50.0) break;
    }

    float glow_str = max(glow_intensity, 0.0);
    float3 glow_col = float3(0.3 + bass * 0.7, 0.1 + highmid * 0.4, 0.5 + treble * 0.5);
    color += glow_col * glow * 0.015 * glow_str;

    color = color / (1.0 + color);
    return float4(color, 1.0);
}

technique Draw {
    pass {
        vertex_shader = VSDefault(vert_in);
        pixel_shader = PSSphereField(vert_in);
    }
}
